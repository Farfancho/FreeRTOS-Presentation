#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_ADDRESS 0x3C

#define OLED_SDA 21
#define OLED_SCL 22

#define LED_PIN 2

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

unsigned long previousOLED = 0;
unsigned long previousLED = 0;

const unsigned long oledInterval = 200;
const unsigned long ledInterval = 50;

unsigned long previousSerial = 0;
const unsigned long serialInterval = 20;

unsigned long previousUART2 = 0;
const unsigned long uart2Interval = 5;

bool ledState = false;

void actualizarOLED(unsigned long tiempo);
void enviarSerial(unsigned long tiempo);
void enviarUART2();

void setup() {
  Serial.begin(115200);
  Serial2.begin(9600, SERIAL_8N1, 16, 17);

  pinMode(LED_PIN, OUTPUT);

  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println("Error iniciando OLED");

    while (true) {
    }
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
}

void loop() {
  unsigned long currentMillis = millis();

  // Tarea 1: LED cada 50 ms
  if (currentMillis - previousLED >= ledInterval) {
    previousLED = currentMillis;

    ledState = !ledState;
    digitalWrite(LED_PIN, ledState);
  }

  // Tarea 2: OLED cada 200 ms
  if (currentMillis - previousOLED >= oledInterval) {
    previousOLED = currentMillis;

    actualizarOLED(currentMillis);
  }

  // Tarea 3: UART
  if (currentMillis - previousSerial >= serialInterval) {
    previousSerial = currentMillis;

    enviarSerial(currentMillis);
  }

  // Tarea 4: UART2
  if (currentMillis - previousUART2 >= uart2Interval) {
    previousUART2 = currentMillis;

    enviarUART2();
  } 
}

void actualizarOLED(unsigned long tiempo) {
  display.clearDisplay();

  display.setCursor(0, 0);
  display.println("ESP32 - millis()");

  display.setCursor(0, 20);
  display.print("Tiempo: ");
  display.print(tiempo);
  display.println(" ms");

  display.display();
}

void enviarSerial(unsigned long tiempo) {
  Serial.print("Tiempo: ");
  Serial.print(tiempo);

  Serial.print(" ms | LED: ");
  Serial.print(ledState);

  Serial.print(" | Valor1: ");
  Serial.print(tiempo % 1000);

  Serial.print(" | Valor2: ");
  Serial.print((tiempo * 3) % 500);

  Serial.print(" | Valor3: ");
  Serial.println((tiempo * 7) % 200);
}

void enviarUART2() {

    for (int i = 0; i < 256; i++) {
        Serial2.write('A');
    }
}